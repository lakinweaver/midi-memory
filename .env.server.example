# The library server. Copy to .env (or .env.server) and adjust.
# Every setting is optional; these are the defaults. With Docker, set them in
# docker-compose.yml instead -- the image already sets DATA_DIR and PORT.

# --- web server ---
MIDI_MEMORY_HOST=0.0.0.0
MIDI_MEMORY_PORT=8080

# Password for the library. Leave empty to disable the login entirely, which is
# reasonable for a machine only reachable from your own network.
# Capture clients are unaffected either way: they authenticate with their own
# secret, not with this.
MIDI_MEMORY_PASSWORD=

# --- storage ---
# Recordings and the database. Back this up and you have backed up everything.
MIDI_MEMORY_DATA_DIR=data
