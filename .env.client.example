# A capture client. Copy to .env (or .env.client) and adjust.
#
# Only the two settings under "link to the server" have to be filled in, and
# both can be set from the client's own web page instead -- so a Raspberry Pi
# never needs a text editor. Everything else already suits a piano in a room.

# --- link to the server ---
# Where the library lives, including the port.
MIDI_MEMORY_SERVER_URL=
# Issued by the server: Settings -> Capture clients -> Add client. Shown once.
MIDI_MEMORY_CLIENT_SECRET=

# --- this client's own settings page ---
MIDI_MEMORY_HOST=0.0.0.0
MIDI_MEMORY_PORT=8081
# The page can repoint this client at another server and holds its secret, so a
# password here is worth more than it looks. The Pi installer generates one.
MIDI_MEMORY_PASSWORD=

# --- recording ---
# Silence, in seconds, that ends a session and files it as its own idea.
MIDI_MEMORY_IDLE_SECONDS=45
# Recordings smaller than these are treated as an accidental key brush.
MIDI_MEMORY_MIN_NOTES=4
MIDI_MEMORY_MIN_SECONDS=2

# Playing one key twice quickly ends the take there and starts the next idea
# fresh, without waiting out the silence above. The two presses are the signal,
# not music, so they are kept out of the recording.
MIDI_MEMORY_MARKER_ENABLED=true
# MIDI note of that key. 108 is C8, the top key of an 88 -- far enough out of
# the way that you will not hit it by accident.
MIDI_MEMORY_MARKER_NOTE=108
# How long you have between the two presses, at the pace of a double click.
MIDI_MEMORY_MARKER_DOUBLE_PRESS_SECONDS=0.5

# Record only from a port whose name contains this. Empty = first suitable port.
# Find names with: python -m midi_memory.tools.ports
MIDI_MEMORY_DEVICE_MATCH=

# auto | alsa | portable | mock | none
MIDI_MEMORY_MIDI_SOURCE=auto

# --- storage ---
MIDI_MEMORY_DATA_DIR=data
# Days to keep a local copy after the server confirms an upload. 0 deletes at
# once. A week of takes is a few megabytes, and it means a mistake on the
# server is recoverable rather than final.
MIDI_MEMORY_KEEP_UPLOADED_DAYS=7
