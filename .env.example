# Copy to .env and adjust. All settings are optional; these are the defaults.

# --- web server ---
MIDI_MEMORY_HOST=0.0.0.0
MIDI_MEMORY_PORT=8080

# Shared password for the web UI. Leave empty to disable the login entirely
# (only sensible if nothing else can reach the Pi).
MIDI_MEMORY_PASSWORD=

# --- recording ---
# Silence, in seconds, that ends a session and files it as its own idea.
MIDI_MEMORY_IDLE_SECONDS=45
# Recordings smaller than these are treated as an accidental key brush.
MIDI_MEMORY_MIN_NOTES=4
MIDI_MEMORY_MIN_SECONDS=2

# Record only from a port whose name contains this. Empty = first suitable port.
# Find names with: python -m app.tools.ports
MIDI_MEMORY_DEVICE_MATCH=

# --- storage ---
MIDI_MEMORY_DATA_DIR=data

# auto | alsa | portable | mock | none
MIDI_MEMORY_MIDI_SOURCE=auto

